{
  "venvPath": ".",
  "venv": ".venv",
  "extraPaths": [
    ".",
    ".venv/Lib/site-packages"
  ],
  "include": [
    "app",
    "alembic",
    "tests"
  ],
  "exclude": [
    "**/__pycache__",
    ".venv",
    "c:/__pyrefly_virtual__/**",
    "**/__pyrefly_virtual__/**",
    "**/inmemory/**"
  ],
  "ignore": [
    "c:/__pyrefly_virtual__/**",
    "**/__pyrefly_virtual__/**",
    "**/inmemory/**"
  ]
}
