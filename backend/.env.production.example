# AI CCTV Platform - Production Environment Variables Template
APP_NAME="AI CCTV Fire & Smoke Monitoring Platform"
APP_ENV="production"
DEBUG=false
VERSION="1.0.0"

# Cryptography & Security
SECRET_KEY="REPLACE_WITH_SECURE_RANDOM_64_CHAR_SECRET"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM="HS256"

# Database Connection (PostgreSQL Production Primary)
DATABASE_URL="postgresql://cctv_user:CHANGE_ME_SECURE_PASSWORD@postgres:5432/cctv_monitor"

# Redis Cache & Broker
REDIS_URL="redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0"

# AI Inference & Worker Configuration
YOLO_MODEL_PATH="models/fire_smoke.pt"
YOLO_CONF_THRESHOLD=0.45
YOLO_IOU_THRESHOLD=0.45
YOLO_DEVICE="0"
MAX_CONCURRENT_AI_JOBS=8
PRE_EVENT_BUFFER_SECONDS=5.0

# Storage & Retention Policy
EVIDENCE_STORAGE_PATH="./evidence"
RECORDINGS_STORAGE_PATH="./recordings"
EVIDENCE_RETENTION_DAYS=30
MIN_FREE_DISK_GB=20.0
MAX_DISK_USAGE_PERCENT=90.0

# Email Alerts Configuration
EMAIL_ALERTS_ENABLED=true
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="alerts@yourdomain.com"
SMTP_PASSWORD="CHANGE_ME_SMTP_PASSWORD"
EMAIL_SENDER="alerts@yourdomain.com"
ALERT_COOLDOWN_SECONDS=60.0

# Security & CORS
ALLOWED_ORIGINS=["https://cctv.yourdomain.com"]
