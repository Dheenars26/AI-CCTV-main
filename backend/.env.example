# Application Configuration
APP_NAME="AI CCTV Fire & Smoke Monitor"
APP_ENV="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Security & CORS
# Comma-separated list of allowed origins or JSON array (e.g., ["http://localhost:3000", "http://localhost:5173"])
CORS_ORIGINS=["*"]
SECRET_KEY="change-this-in-production-super-secret-key-32chars"

# Database Configuration (Relational / SQLAlchemy)
DATABASE_URL="postgresql://cctv_user:cctv_password@localhost:5432/cctv_monitor_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# MongoDB Configuration (Hybrid Detection & Telemetry Store)
MONGODB_ENABLED=true
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="cctv_ai_surveillance"

# Logging Configuration
LOG_LEVEL="INFO"
LOG_FILE_PATH="logs/app.log"

# RTSP / DVR Configuration (Credentials stored safely on backend ONLY)
DEFAULT_RTSP_TIMEOUT_SECONDS=10
MAX_RECONNECT_ATTEMPTS=5

# Future AI Model Paths (Placeholders)
FIRE_MODEL_PATH="models/weights/fire_detection.onnx"
SMOKE_MODEL_PATH="models/weights/smoke_detection.onnx"

# AI Optimization & Compute Parameters
AI_DEVICE="cuda"
AI_HALF_PRECISION=true
AI_IMAGE_SIZE=640
AI_TARGET_FPS=10
ENABLE_PERSON_TRACKING=true

# ---------------------------------------------------------------------------
# Detection accuracy & performance tuning (see backend/README.md)
# ---------------------------------------------------------------------------
# Worker-crop refinement: re-runs the PPE network on the head/torso of workers whose required
# item is still missing. This is what makes safety-glasses detection possible at CCTV distances.
ENABLE_PPE_ROI=true
PPE_CROP_REFINE_MAX_PERSONS=4
PPE_ROI_REFINE_EVERY_N=2          # Refine on every Nth worker frame (1 = every frame, most accurate)

# Motion gate: skips worker/PPE inference on frames with no motion and no tracked worker.
AI_MOTION_GATE_ENABLED=true
AI_MOTION_SWEEP_SECONDS=2.5       # Guaranteed full-scene inspection cadence
ENABLE_PERSON_ROI_REFINE=true     # Second-pass worker search on motion regions

# Post-processing engine
AI_WBF_ENABLED=true               # Weighted Box Fusion (merges duplicate boxes, stabilises them)
AI_ORT_THREADS=0                  # 0 = auto (2-4 threads depending on core count)

# Association policy: equipment that belongs to nobody is never reported
PPE_REQUIRE_PERSON_ASSOCIATION=true
ENABLE_VEST_HIVIS_CORROBORATION=true
VEST_HIVIS_MIN_COLOR_RATIO=0.06
VEST_HIVIS_MIN_SILVER_RATIO=0.10
# Legacy OpenCV glasses heuristic: measured 96% false-positive rate, superseded by ROI refinement
ENABLE_CV_GLASSES_FALLBACK_ON_NEURAL_PATH=false

# Class-Specific Confidence Thresholds
#   Candidate floors decide what is *reported and drawn*; alert floors decide what dispatches an alert.
FIRE_CANDIDATE_CONFIDENCE=0.14
SMOKE_CANDIDATE_CONFIDENCE=0.13
FIRE_ALERT_CONFIDENCE=0.35
SMOKE_ALERT_CONFIDENCE=0.30
FIRE_STRUCTURE_EDGE_RATIO=0.45
FIRE_CONFIDENCE_THRESHOLD=0.35
SMOKE_CONFIDENCE_THRESHOLD=0.30
PERSON_CONFIDENCE_THRESHOLD=0.40
VEST_CONFIDENCE_THRESHOLD=0.35
GLASSES_CONFIDENCE_THRESHOLD=0.25

# Fire, Smoke & PPE Temporal Verification Settings
FIRE_MIN_CONSECUTIVE_FRAMES=3
FIRE_MIN_DURATION_SECONDS=1.0
SMOKE_MIN_CONSECUTIVE_FRAMES=3
SMOKE_MIN_DURATION_SECONDS=1.0
SMOKE_ALERT_COOLDOWN_SECONDS=30.0
# Frames are counted in worker-branch invocations (measured cadence), so 3 frames + 1.2 s of
# sustained evidence keeps alert latency bounded by time rather than by hardware speed.
PPE_VERIFICATION_FRAMES=3
PPE_VERIFICATION_DURATION_SECONDS=1.2
PPE_ANALYSIS_REUSE_SECONDS=2.0

