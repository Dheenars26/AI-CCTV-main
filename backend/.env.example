# Application Configuration
APP_NAME="AI CCTV Fire & Smoke Monitor"
APP_ENV="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Security & CORS
# Comma-separated list of allowed origins or JSON array (e.g., ["http://localhost:3000", "http://localhost:5173"])
CORS_ORIGINS=["*"]
SECRET_KEY="change-this-in-production-super-secret-key-32chars"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://cctv_user:cctv_password@localhost:5432/cctv_monitor_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Logging Configuration
LOG_LEVEL="INFO"
LOG_FILE_PATH="logs/app.log"

# RTSP / DVR Configuration (Credentials stored safely on backend ONLY)
DEFAULT_RTSP_TIMEOUT_SECONDS=10
MAX_RECONNECT_ATTEMPTS=5

# Future AI Model Paths (Placeholders)
FIRE_MODEL_PATH="models/weights/fire_detection.onnx"
SMOKE_MODEL_PATH="models/weights/smoke_detection.onnx"

# AI Optimization & Compute Parameters
AI_DEVICE="cuda"
AI_HALF_PRECISION=true
AI_IMAGE_SIZE=640
AI_TARGET_FPS=10
ENABLE_PERSON_TRACKING=true
ENABLE_PPE_ROI=false

# Class-Specific Confidence Thresholds
FIRE_CONFIDENCE_THRESHOLD=0.35
SMOKE_CONFIDENCE_THRESHOLD=0.30
PERSON_CONFIDENCE_THRESHOLD=0.40
VEST_CONFIDENCE_THRESHOLD=0.35
GLASSES_CONFIDENCE_THRESHOLD=0.25

# Fire, Smoke & PPE Temporal Verification Settings
FIRE_MIN_CONSECUTIVE_FRAMES=3
FIRE_MIN_DURATION_SECONDS=1.0
SMOKE_MIN_CONSECUTIVE_FRAMES=3
SMOKE_MIN_DURATION_SECONDS=1.0
SMOKE_ALERT_COOLDOWN_SECONDS=30.0
PPE_VERIFICATION_FRAMES=5
PPE_VERIFICATION_DURATION_SECONDS=2.0

