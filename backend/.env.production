# AI CCTV Platform - Production Environment Configuration
APP_NAME="AI CCTV Fire, Smoke & Workplace Safety Monitoring Platform"
APP_ENV="production"
DEBUG=false
VERSION="1.0.0"

# Cryptography & Security
SECRET_KEY="cctv_prod_super_secret_key_change_me_before_external_exposure_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM="HS256"

# Database Connection (PostgreSQL Docker Container)
DATABASE_URL="postgresql://cctv_user:cctv_secure_pass_2026@postgres:5432/cctv_monitor"

# Redis Cache & Broker
REDIS_URL="redis://:cctv_redis_pass_2026@redis:6379/0"

# MongoDB Telemetry Store
MONGO_URI="mongodb://mongo:27017"
MONGO_DB="cctv_ai_surveillance"

# AI Inference Configuration
YOLO_MODEL_PATH="models/fire_smoke.pt"
YOLO_CONF_THRESHOLD=0.45
YOLO_IOU_THRESHOLD=0.45
YOLO_DEVICE="cpu"
MAX_CONCURRENT_AI_JOBS=4
PRE_EVENT_BUFFER_SECONDS=5.0

# Storage & Retention Policy
EVIDENCE_STORAGE_PATH="/app/evidence"
RECORDINGS_STORAGE_PATH="/app/recordings"
EVIDENCE_RETENTION_DAYS=30
MIN_FREE_DISK_GB=10.0
MAX_DISK_USAGE_PERCENT=90.0

# Email Alerts Configuration (Optional - set to true to enable)
EMAIL_ALERTS_ENABLED=false
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="alerts@yourdomain.com"
SMTP_PASSWORD=""
EMAIL_SENDER="alerts@yourdomain.com"
ALERT_COOLDOWN_SECONDS=60.0

# Security & CORS (Allow all for internal LAN by default, or restrict to domain)
ALLOWED_ORIGINS=["*"]
